# Public base URL of the separately deployed FastAPI service.
# Leave unset during local development: Vite proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=https://api.example.com

# Optional. Only set this when the WebSocket service has a different public origin.
# VITE_WS_BASE_URL=wss://stream.example.com

# CARTO Basemap API key (for tile access without watermarks)
VITE_CARTO_API_KEY=

# Backend-only: absolute path and expected checksum of the Ultralytics checkpoint.
AQUASENSE_MODEL_PATH=/data/models/best.pt
AQUASENSE_MODEL_SHA256=342954fdd4ef6a24b89797f68dbeda8ffd9180b1cc7f7f291324c5cee5898f53

# Backend inference controls.
AQUASENSE_DEVICE=cpu
AQUASENSE_CONF_THRESH=0.10
AQUASENSE_IOU_THRESH=0.45
AQUASENSE_TILE_SIZE=640
AQUASENSE_BATCH_SIZE=4

# Development only: the normal dev command may still use the labelled heuristic fallback.
# Production commands run `python -m app.preflight` and refuse startup without a verified model.
